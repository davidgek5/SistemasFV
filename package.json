{
  "name": "sistemasfv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dimensionamiento y simulación horaria de sistemas fotovoltaicos (on-grid, off-grid, híbridos)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "catalogo:semilla": "node scripts/build-cec-seed.mjs",
    "fixtures": "python3 scripts/pvlib-fixtures/generar.py"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "echarts": "6.1.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
